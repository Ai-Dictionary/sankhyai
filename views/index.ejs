<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Aikyo by Mockmantra - Master Tech & Academics with Industry Mentors. Live online courses in AI, Backend, Python, and Competitive Academics.">
    <meta name="keywords" content="Aikyo, Mockmantra, EdTech, AI Courses, Backend Development, Python, JEE Mathematics, Physics">
    <title>Aikyo - EdTech Platform</title>
    <link rel="stylesheet" href="../static/App.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- ==================== HEADER / NAVBAR ==================== -->
    <header class="header">
        <div class="container navbar">
            <a href="#home" class="logo-container">
                <div class="logo-title">Aikyo<span>.</span></div>
                <div class="logo-tag">Powered by Mockmantra</div>
            </a>
            
            <ul class="nav-menu" id="nav-menu">
                <li><a href="#home" class="nav-link">Home</a></li>
                <li><a href="#courses" class="nav-link">Courses</a></li>
                <li><a href="#mentors" class="nav-link">Mentors</a></li>
                <li><a href="#about" class="nav-link">About Us</a></li>
                <li><a href="#contact" class="nav-link">Contact</a></li>
                <li><a href="#register" class="btn btn-primary">Register Now</a></li>
            </ul>

            <div class="hamburger" id="hamburger">
                <i class="fa-solid fa-bars"></i>
            </div>
        </div>
    </header>

    <!-- ==================== HERO SECTION ==================== -->
    <section class="hero" id="home">
        <div class="container hero-grid">
            <div class="hero-content">
                <span class="badge badge-tech" style="margin-bottom: 15px;">Transformative Education</span>
                <h1>Master Tech & Academics with Industry Mentors at <span>Aikyo</span></h1>
                <p>Transform your career and score top ranks with live online courses in AI, Backend, Python, and Competitive Board Academics.</p>
                <div class="hero-btns">
                    <a href="#courses" class="btn btn-primary"><i class="fa-solid fa-compass"></i> Explore Courses</a>
                    <a href="#register" class="btn btn-secondary">Join Now</a>
                </div>
            </div>

            <div class="hero-visual">
                <div class="hero-card-graphics">
                    <div>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                            <span style="font-size:0.8rem; color:var(--primary); font-weight:700;">LIVE SESSION</span>
                            <span style="font-size:0.75rem; background:rgba(255,255,255,0.1); padding:3px 8px; border-radius:4px;">● Interactive</span>
                        </div>
                        <h3 style="font-size:1.3rem; margin-bottom:10px;">Full-Stack AI & Engineering Track</h3>
                        <p style="font-size:0.85rem; color:#94A3B8;">Building scalable systems and learning core algorithmic foundations.</p>
                    </div>

                    <div style="background:rgba(255,255,255,0.05); padding:15px; border-radius:8px; display:flex; gap:15px; align-items:center;">
                        <i class="fa-solid fa-code" style="font-size:1.5rem; color:var(--primary);"></i>
                        <div>
                            <div style="font-size:0.85rem; font-weight:600;">Hands-on Project Based</div>
                            <div style="font-size:0.75rem; color:#94A3B8;">Guaranteed Project Reviews</div>
                        </div>
                    </div>
                </div>

                <div class="floating-badge fb-1">
                    <i class="fa-solid fa-graduation-cap" style="color:var(--primary); font-size:1.2rem;"></i>
                    <div>
                        <div>100% Mentorship</div>
                        <span style="font-size:0.7rem; color:var(--text-muted);">By Industry Leads</span>
                    </div>
                </div>

                <div class="floating-badge fb-2">
                    <i class="fa-solid fa-certificate" style="color:#10B981; font-size:1.2rem;"></i>
                    <div>
                        <div>Certified Programs</div>
                        <span style="font-size:0.7rem; color:var(--text-muted);">Mockmantra Verified</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== COURSES SECTION ==================== -->
    <section class="section-padding" id="courses">
        <div class="container">
            <div class="section-header">
                <h2>Our Premium Courses</h2>
                <p>Tailored live programs engineered for industry readiness and academic excellence.</p>
            </div>

            <div class="courses-grid" id="courses-container">
                <!-- Javascript will inject 8 course cards dynamically -->
            </div>
        </div>
    </section>

    <!-- ==================== MENTORS SECTION ==================== -->
    <section class="section-padding mentors" id="mentors">
        <div class="container">
            <div class="section-header">
                <h2>Learn from Industry Experts</h2>
                <p>Guided by seasoned developers, AI researchers, and academic top-rankers.</p>
            </div>

            <div class="mentors-grid">
                <div class="mentor-card">
                    <div class="mentor-avatar"><i class="fa-solid fa-user-tie"></i></div>
                    <div class="mentor-name">Sunny Ghosh</div>
                    <div class="mentor-role">Mathematics & AI Logics Specialist</div>
                    <p style="font-size:0.85rem; color:var(--text-muted);">Expert in competitive mathematical modeling, advanced algorithms, and core AI logical structures.</p>
                </div>

                <div class="mentor-card">
                    <div class="mentor-avatar"><i class="fa-solid fa-code"></i></div>
                    <div class="mentor-name">Krishnendu Mitra</div>
                    <div class="mentor-role">Backend & Core Languages Lead</div>
                    <p style="font-size:0.85rem; color:var(--text-muted);">Specializes in distributed systems, C architecture, high-performance APIs, and cloud setups.</p>
                </div>

                <div class="mentor-card">
                    <div class="mentor-avatar"><i class="fa-solid fa-atom"></i></div>
                    <div class="mentor-name">Deepro Naon</div>
                    <div class="mentor-role">Academic & Physics Lead</div>
                    <p style="font-size:0.85rem; color:var(--text-muted);">Passionate academician simplifying complex theoretical mechanics and JEE/NEET physics concepts.</p>
                </div>

                <div class="mentor-card">
                    <div class="mentor-avatar"><i class="fa-solid fa-brain"></i></div>
                    <div class="mentor-name">AI Guest Faculty</div>
                    <div class="mentor-role">SaaS & Machine Learning Experts</div>
                    <p style="font-size:0.85rem; color:var(--text-muted);">Visiting mentors from top product firms offering real-world product building exposure.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== REGISTRATION FORM SECTION ==================== -->
    <section class="section-padding" id="register" style="background: linear-gradient(180deg, #FFFDF5 0%, #FAFAFA 100%);">
        <div class="container">
            <div class="section-header">
                <h2>Student Registration</h2>
                <p>Reserve your seat now. Complete the form to get instant counseling details.</p>
            </div>

            <div class="reg-wrapper">
                <div id="alert-box" class="alert-box"></div>

                <form id="registration-form">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="studentName">Student Full Name *</label>
                            <input type="text" id="studentName" required placeholder="John Doe">
                        </div>

                        <div class="form-group">
                            <label for="parentName">Parent / Guardian Name *</label>
                            <input type="text" id="parentName" required placeholder="Robert Doe">
                        </div>

                        <div class="form-group">
                            <label for="phone">Contact / WhatsApp Number *</label>
                            <input type="tel" id="phone" required placeholder="10-digit mobile number">
                        </div>

                        <div class="form-group">
                            <label for="email">Email Address *</label>
                            <input type="email" id="email" required placeholder="john@example.com">
                        </div>

                        <div class="form-group">
                            <label for="state">State *</label>
                            <select id="state" required>
                                <option value="" disabled selected>Select State</option>
                                <option value="West Bengal">West Bengal</option>
                                <option value="Delhi">Delhi</option>
                                <option value="Maharashtra">Maharashtra</option>
                                <option value="Karnataka">Karnataka</option>
                                <option value="Tamil Nadu">Tamil Nadu</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="classSem">Class / Semester *</label>
                            <input type="text" id="classSem" required placeholder="e.g. Class 12 / Sem 4">
                        </div>

                        <div class="form-group">
                            <label for="schoolCollege">School / College Name *</label>
                            <input type="text" id="schoolCollege" required placeholder="Institute Name">
                        </div>

                        <div class="form-group">
                            <label for="boardUniv">Board / University *</label>
                            <input type="text" id="boardUniv" required placeholder="e.g. CBSE / ISC / MAKAUT">
                        </div>

                        <div class="form-group full-width">
                            <label for="preferredCourse">Preferred Course *</label>
                            <select id="preferredCourse" required>
                                <option value="" disabled selected>Select a course</option>
                                <!-- JS will populate options dynamically -->
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 25px; height: 50px;" id="submit-btn">
                        <span id="btn-text">Complete Registration</span>
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- ==================== ABOUT US SECTION ==================== -->
    <section class="section-padding" id="about">
        <div class="container">
            <div class="about-content">
                <div class="about-text">
                    <span class="badge badge-tech" style="margin-bottom:10px;">Who We Are</span>
                    <h3>Official Educational Initiative by Mockmantra</h3>
                    <p><strong>Aikyo</strong> is an official initiative by <strong>Mockmantra</strong> dedicated to accessible, high-quality, industry-grade learning. We bridge the gap between core academic foundational knowledge and modern AI/Software production setups.</p>
                    <p>We educate students on trending AI tools, preparing them to be industry-ready with accredited certifications. Outstanding and dedicated aspirants are personally selected to join our internal engineering team on real SaaS, AI, Cloud, and Digital Marketing projects.</p>
                    
                    <ul class="about-list">
                        <li><i class="fa-solid fa-circle-check"></i> Live Interactive Practical Sessions</li>
                        <li><i class="fa-solid fa-circle-check"></i> Verified Certificates from Mockmantra</li>
                        <li><i class="fa-solid fa-circle-check"></i> Opportunity to work on internal Live SaaS/AI projects</li>
                    </ul>
                </div>

                <div class="about-box">
                    <h4>The Philosophy Behind "Aikyo"</h4>
                    <p style="font-size:0.9rem; line-height: 1.7; color: #CBD5E1;">
                        "Aikyo" symbolizes <em>Unity in AI Knowledge</em>. Inspired by Japanese principles of continuous learning and perfection, our name stands for Indo-Japan AI unity thoughts. While we are entirely an Indian EdTech brand powered by Mockmantra, we deeply respect this mindset of discipline, perfection, and progressive technological growth.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== FOOTER ==================== -->
    <footer class="footer" id="contact">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <a href="#home" class="footer-logo">Aikyo<span>.</span></a>
                    <p>Empowering the next generation of engineers, coders, and academic achievers through live expert-led interactive training.</p>
                    <div class="social-icons">
                        <a href="#" class="social-btn"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="social-btn"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#" class="social-btn"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="social-btn"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>

                <div class="footer-col">
                    <h4>Quick Links</h4>
                    <ul class="footer-links">
                        <li><a href="#home">Home</a></li>
                        <li><a href="#courses">Courses</a></li>
                        <li><a href="#mentors">Mentors</a></li>
                        <li><a href="#about">About Us</a></li>
                        <li><a href="#register">Register</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Courses</h4>
                    <ul class="footer-links">
                        <li><a href="#courses">API / Backend</a></li>
                        <li><a href="#courses">AI / ML Dev</a></li>
                        <li><a href="#courses">Python Tracks</a></li>
                        <li><a href="#courses">JEE Math & Physics</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Contact Us</h4>
                    <ul class="footer-links" style="font-size:0.85rem;">
                        <li style="display:flex; gap:10px; align-items:center;"><i class="fa-solid fa-envelope" style="color:var(--primary)"></i> support@mockmantra.in</li>
                        <li style="display:flex; gap:10px; align-items:center;"><i class="fa-solid fa-phone" style="color:var(--primary)"></i> +91 9123725365</li>
                        <li style="display:flex; gap:10px; align-items:center;"><i class="fa-brands fa-whatsapp" style="color:var(--primary)"></i> Connect on WhatsApp</li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2026 Aikyo by Mockmantra. All rights reserved.</p>
            </div>
        </div>
    </footer>
<script src="../static/App.js" nonce="<%= nonce %>"></script>
<script type="application/ld+json" nonce="<%= nonce %>">
{
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "aikyo",
    "url": "https://aikyo.mockmantra.in",
    "logo": "https://aikyo.vercel.app/public/logo1500.png",
    "description": "Aikyo by Mockmantra - Master Tech & Academics with Industry Mentors. Live online courses in AI, Backend, Python, and Competitive Academics."
}
</script>
</body>
</html>
